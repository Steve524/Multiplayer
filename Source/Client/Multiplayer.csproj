<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RimWorldTargetFramework)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ReleaseVersion>0.6.2</ReleaseVersion>
    <PublicizeAsReferenceAssemblies>false</PublicizeAsReferenceAssemblies>
    <RootNamespace>Multiplayer.Client</RootNamespace>
    <AssemblyName>Multiplayer</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\Languages\English\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" />
    <PackageReference Include="Lib.Harmony" Version="$(MultiplayerHarmonyVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="RestSharp" Version="106.15.0" />
    <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".editorconfig" />
    <None Remove="mono_crash.*.json" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp;0Harmony;UnityEngine.IMGUIModule" Condition="'$(RimWorldVersion)' != '1.7'" />
    <Publicize Include="Assembly-CSharp;0Harmony;UnityStubs" Condition="'$(RimWorldVersion)' == '1.7'" />
    <DoNotPublicize Include="0Harmony:System.Runtime.CompilerServices.DefaultInterpolatedStringHandler" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiplayerLoader\MultiplayerLoader.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
<!--    <Reference Include="Multiplayer">-->
<!--      <HintPath>bin\Multiplayer.dll_orig</HintPath>-->
<!--    </Reference>-->
  </ItemGroup>

  <!-- Ignore any system frameworks and get the system assemblies from Krafs.Rimworld.Ref -->
  <Target Name="RemoveFramework" BeforeTargets="PrepareForBuild" DependsOnTargets="GetReferenceAssemblyPaths" Condition="'$(RimWorldVersion)' != '1.7'">
    <PropertyGroup>
      <TargetFrameworkDirectory></TargetFrameworkDirectory>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <ModOutputPath>../../$(RimWorldVersion)</ModOutputPath>
  </PropertyGroup>

  <PropertyGroup Label="Normalise stack trace file locations">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=$(AssemblyName)/</PathMap>
  </PropertyGroup>

  <Target Name="CopyToRimworld" AfterTargets="Build">
    <ItemGroup>
      <ModRuntimeAssemblies Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(Extension)' == '.dll' and '%(Filename)' != 'MultiplayerCommon'" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Multiplayer.pdb;$(TargetDir)MultiplayerCommon.dll;$(TargetDir)MultiplayerCommon.pdb"
          DestinationFolder="$(ModOutputPath)/AssembliesCustom/" />
    <Copy SourceFiles="@(ModRuntimeAssemblies)" DestinationFolder="$(ModOutputPath)/Assemblies/" />
  </Target>

  <Import Project="PersonalDefinitions.targets" Condition="exists('PersonalDefinitions.targets')" />
</Project>
